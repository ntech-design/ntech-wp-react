{
  "compilerOptions": {
    "composite": true,

    "module": "ESNext",
    "moduleResolution": "bundler",

    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "paths": {
      "yet-another-react-lightbox": ["./vendor/yet-another-react-lightbox/dist/index.d.ts"],
      "yet-another-react-lightbox/*": ["./vendor/yet-another-react-lightbox/dist/*"]
    },

    "types": ["node"]
  },

  "include": [
    "vite.config.ts",
    "eslint.config.mjs",
    "postcss.config.js"
  ]
}
