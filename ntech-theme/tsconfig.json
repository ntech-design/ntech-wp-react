{
  "compilerOptions": {
    "lib": ["es6", "dom"],
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "pretty": true,
    "outDir": "./dist",
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@types/react": ["./node_modules/preact/compat"],
      "@types/react-dom": ["./node_modules/preact/compat"],
      "yet-another-react-lightbox": ["./vendor/yet-another-react-lightbox/dist/index.d.ts"],
      "yet-another-react-lightbox/*": ["./vendor/yet-another-react-lightbox/dist/*"],
      "@/*": ["./src/*"],
    },
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "./node_modules",
    "./node_modules/*",
    "./node_modules/@types/node/index.d.ts"
  ],
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}
